# Copy to .env.local for local overrides (gitignored), or set these as
# environment variables on your hosting provider (Render, Vercel, Netlify).
#
# Vite only exposes vars prefixed with VITE_ to the client bundle.

# ─── API base URL ─────────────────────────────────────────────────────
# Production: point to your deployed .NET API (full URL including /api).
# Leave unset locally — Vite's dev proxy in vite.config.ts forwards
# /api/* to https://localhost:7080 automatically.
#
# VITE_API_BASE_URL=https://realestateapi-2k2n.onrender.com/api
